# Settings for the AI service. Copy this file to ".env" (same folder) and edit; ".env" is never pushed to GitHub.
# The AI service reads it when it starts, so nothing has to be typed in the terminal.

# Our fine-tuned explanation model, served by Ollama on this computer (leave empty to use the templates only)
MEDILENS_MODEL_URL=http://localhost:11434
MEDILENS_MODEL_NAME=medilens-qwen
# How many explanations to write at the same time (set OLLAMA_NUM_PARALLEL to the same number)
MEDILENS_MODEL_PARALLEL=4

# Windows: where tesseract.exe is, if it is not on PATH
# TESSERACT_CMD=C:\Users\YOUR-NAME\AppData\Local\Programs\Tesseract-OCR\tesseract.exe
