# Copy this file to .env and change the values.
DATABASE_URL="postgresql://medilens:medilens@localhost:5432/medilens"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
# Python AI service (run: uvicorn api.main:app --port 8000)
AI_SERVICE_URL="http://localhost:8000"
# The website's address, allowed to call this API
FRONTEND_ORIGIN="http://localhost:3000"
UPLOAD_DIR="./uploads"
# Optional: enables "Sign in with Google" (Google Cloud Console > Credentials > OAuth client ID, type Web)
GOOGLE_CLIENT_ID=""
